    "To join, drag a window to another and press Command, or click the open lock on the seam of two windows side by side." : {
      "comment" : "Text in the settings window",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe ein Fenster zu einem anderen und drücke die Befehlstaste, um sie zu verbinden, oder klicke auf das offene Schloss an der Naht zweier nebeneinanderliegender Fenster."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
