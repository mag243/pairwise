    "Lets Pairwise move and resize the windows you join." : {
      "comment" : "Text in the settings window",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit kann Pairwise die Fenster, die du verbindest, bewegen und ihre Größe ändern."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee kan Pairwise de vensters die je koppelt verplaatsen en van formaat veranderen."
          }
        }
      }
    },
    "Lets Pairwise show pictures of joined windows while you drag them. They are not saved or sent anywhere." : {
      "comment" : "Text in the settings window",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit kann Pairwise Bilder verbundener Fenster zeigen, während du sie ziehst. Sie werden weder gespeichert noch irgendwohin gesendet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee kan Pairwise beelden van gekoppelde vensters tonen terwijl je ze sleept. Die worden niet bewaard en nergens heen gestuurd."
          }
        }
      }
    },
