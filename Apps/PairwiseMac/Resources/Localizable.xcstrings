    "Accessibility" : {
      "comment" : "The system permission Pairwise needs",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedienungshilfen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegankelijkheid"
          }
        }
      }
    },
    "Drag a window and hold Command over another window to join them. To part them, hold Command before you drag one away." : {
      "comment" : "How to join and part windows",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe ein Fenster und halte die Befehlstaste über einem anderen Fenster, um sie zu verbinden. Zum Trennen halte die Befehlstaste, bevor du eines wegziehst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep een venster en houd Command ingedrukt boven een ander venster om ze te koppelen. Houd Command ingedrukt voordat je er een wegsleept om ze los te maken."
          }
        }
      }
    },
    "Grant Access…" : {
      "comment" : "Button that opens the system's permission prompt",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
