    },
    "The pointer cannot be watched. Quit and reopen Pairwise after granting access." : {
      "comment" : "Problem message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zeiger kann nicht beobachtet werden. Beende Pairwise und öffne es erneut, nachdem du den Zugriff erlaubt hast."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De aanwijzer kan niet worden gevolgd. Stop Pairwise en open het opnieuw nadat je toegang hebt gegeven."
          }
        }
      }
    },
    "The window has gone." : {
      "comment" : "Problem message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fenster ist nicht mehr da."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het venster is verdwenen."
          }
        }
      }
    },
    "The window refuses to move." : {
      "comment" : "Problem message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fenster lässt sich nicht bewegen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het venster laat zich niet verplaatsen."
          }
        }
      }
    },
    "The window's app does not answer." : {
      "comment" : "Problem message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App des Fensters antwortet nicht."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app van het venster reageert niet."
          }
        }
