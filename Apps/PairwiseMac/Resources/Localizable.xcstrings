        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld beelden per seconde"
          }
        }
      }
    },
    "95th percentile (ms)" : {
      "comment" : "Measurement: duration 95 percent of moves stay within",
      "localizations" : {
        "de" : {
          "stringUnit" : {
