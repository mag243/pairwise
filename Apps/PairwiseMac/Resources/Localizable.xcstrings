    },
    "The pointer cannot be watched. Quit and reopen Pairwise after granting access." : {
      "comment" : "Problem message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zeiger kann nicht beobachtet werden. Beende Pairwise und öffne es erneut, nachdem du den Zugriff erlaubt hast."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De aanwijzer kan niet worden gevolgd. Stop Pairwise en open het opnieuw nadat je toegang hebt gegeven."
          }
        }
      }
    },
    "The window has gone." : {
      "comment" : "Problem message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fenster ist nicht mehr da."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het venster is verdwenen."
          }
        }
      }
    },
    "The window refuses to move." : {
      "comment" : "Problem message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fenster lässt sich nicht bewegen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het venster laat zich niet verplaatsen."
          }
        }
      }
    },
    "The window's app does not answer." : {
      "comment" : "Problem message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App des Fensters antwortet nicht."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app van het venster reageert niet."
          }
        }
      }
    },
    "To join, drag a window to another and press Command, or click the open lock on the seam of two windows side by side." : {
      "comment" : "Text in the settings window",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe ein Fenster zu einem anderen und drücke die Befehlstaste, um sie zu verbinden, oder klicke auf das offene Schloss an der Naht zweier nebeneinanderliegender Fenster."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep een venster naar een ander en druk op Command om ze te koppelen, of klik op het open slotje op de naad van twee vensters naast elkaar."
          }
        }
      }
    },
    "To move a pair, drag either window." : {
      "comment" : "Text in the settings window",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe eines der Fenster, um ein Paar zu bewegen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep een van de vensters om een paar te verplaatsen."
          }
        }
      }
    },
    "To part them, click the closed lock on the seam, or press Command while dragging one." : {
      "comment" : "Text in the settings window",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf das geschlossene Schloss an der Naht, um sie zu trennen, oder drücke die Befehlstaste, während du eines ziehst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik op het dichte slotje op de naad om ze los te koppelen, of druk op Command terwijl je er een sleept."
          }
        }
      }
    },
    "To resize both, drag the seam between them." : {
      "comment" : "Text in the settings window",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe die Naht dazwischen, um die Größe beider zu ändern."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep de naad ertussen om beide van formaat te veranderen."
          }
        }
