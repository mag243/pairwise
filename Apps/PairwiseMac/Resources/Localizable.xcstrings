    "The pointer cannot be watched. Quit and reopen Pairwise after granting access." : {
      "comment" : "Problem message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zeiger kann nicht beobachtet werden. Beende Pairwise und öffne es erneut, nachdem du den Zugriff erlaubt hast."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De aanwijzer kan niet worden gevolgd. Stop Pairwise en open het opnieuw nadat je toegang hebt gegeven."
          }
        }
      }
    },
    "The window has gone." : {
