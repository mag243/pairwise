    },
    "Pairwise has no Screen Recording access." : {
      "comment" : "The Screen Recording permission is missing",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pairwise hat keinen Zugriff auf die Bildschirmaufnahme."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pairwise heeft geen toegang tot Schermopname."
