# Pinned tool versions for the Pairwise development environment.
# tools/setup.sh verifies or installs exactly these; tools/build.sh uses them.
# Change a version here, run tools/setup.sh again, and commit this file.

# Xcode, which also provides Swift, swift-format, and the SDKs. setup.sh cannot
# install it; it checks that the selected Xcode matches this major.minor version.
# https://developer.apple.com/xcode/
XCODE_VERSION="27.2"

# The Xcode that CI uses: the newest one on the GitHub macOS runner image, which
# lags behind the local pin (ADR 0008). setup.sh checks this one when CI=true.
CI_XCODE_VERSION="26.6"

# Command-line tools from Homebrew. Homebrew installs its current release; these
# are the minimum versions setup.sh accepts.
BASH_MIN_VERSION="4.4"
WEBP_MIN_VERSION="1.3"
XCBEAUTIFY_MIN_VERSION="3.0"
SHELLCHECK_MIN_VERSION="0.10"
SWIFTLINT_MIN_VERSION="0.65"

# dmgbuild, which lays out the release disk image without Finder (ADR 0056).
# Installed at exactly this version into build/tools/dmgbuild by tools/build.sh
# package when missing. https://pypi.org/project/dmgbuild/
DMGBUILD_VERSION="1.6.7"
